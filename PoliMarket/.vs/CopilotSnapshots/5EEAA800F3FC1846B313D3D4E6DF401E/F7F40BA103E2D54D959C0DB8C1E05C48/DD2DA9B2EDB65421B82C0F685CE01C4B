        private bool ValidarCampos()
        {
            // Validar campos vacíos
            if (string.IsNullOrWhiteSpace(txtBNombreCliente.Text) ||
                string.IsNullOrWhiteSpace(txtBApellidoCliente.Text) ||
                string.IsNullOrWhiteSpace(txtBCedulaCliente.Text) ||
                string.IsNullOrWhiteSpace(txtBCorreoElectronicoCliente.Text) ||
                string.IsNullOrWhiteSpace(txtBDireccionCliente.Text))
            {
                MessageBox.Show("Ningún campo debe estar vacío.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            // Validar solo letras y primera mayúscula en nombre y apellido
            if (!System.Text.RegularExpressions.Regex.IsMatch(txtBNombreCliente.Text, @"^[A-Za-zÁÉÍÓÚáéíóúÑñ]+$"))
            {
                MessageBox.Show("El nombre solo debe contener letras.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }
            if (!System.Text.RegularExpressions.Regex.IsMatch(txtBApellidoCliente.Text, @"^[A-Za-zÁÉÍÓÚáéíóúÑñ]+$"))
            {
                MessageBox.Show("El apellido solo debe contener letras.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            // Validar cédula: exactamente 10 dígitos numéricos
            if (!System.Text.RegularExpressions.Regex.IsMatch(txtBCedulaCliente.Text, @"^\d{10}$"))
            {
                MessageBox.Show("La cédula debe tener exactamente 10 dígitos numéricos.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            // Validar correo electrónico
            if (!System.Text.RegularExpressions.Regex.IsMatch(txtBCorreoElectronicoCliente.Text, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            {
                MessageBox.Show("El correo electrónico no tiene un formato válido.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            return true;
        }

