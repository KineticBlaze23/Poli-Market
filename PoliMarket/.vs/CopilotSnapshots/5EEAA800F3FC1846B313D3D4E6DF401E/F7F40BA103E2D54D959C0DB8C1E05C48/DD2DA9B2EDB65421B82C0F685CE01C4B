        private void CapitalizarTextoEnTiempoReal(TextBox textBox)
        {
            if (string.IsNullOrEmpty(textBox.Text))
                return;

            int selStart = textBox.SelectionStart;
            int selLength = textBox.SelectionLength;

            // Capitaliza cada palabra
            string textoOriginal = textBox.Text;
            string textoCapitalizado = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(textoOriginal.ToLower());

            if (textoOriginal != textoCapitalizado)
            {
                textBox.Text = textoCapitalizado;
                // Mantener el cursor en la posición correcta
                textBox.SelectionStart = selStart;
                textBox.SelectionLength = selLength;
            }
        }

