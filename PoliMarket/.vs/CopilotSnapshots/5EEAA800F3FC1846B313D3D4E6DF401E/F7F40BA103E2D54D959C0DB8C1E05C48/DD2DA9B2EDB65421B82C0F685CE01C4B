        private void btnValidarCliente_Click(object sender, EventArgs e)
        {
            string cedula = txtCedulaClienteVenta.Text.Trim();

            if (string.IsNullOrWhiteSpace(cedula))
            {
                MessageBox.Show("Ingrese la cédula del cliente.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // Buscar cliente por cédula
            var cliente = negocioCliente.ListarClientes()
                .FirstOrDefault(c => c.Cedula == cedula);

            if (cliente != null)
            {
                // Mostrar datos en el label solicitado
                lblDatodClienteVenta.Text = $"Nombre: {cliente.Nombre} {cliente.Apellido}\nCédula: {cliente.Cedula}\nCorreo: {cliente.CorreoElectronico}\nDirección: {cliente.Direccion}";
            }
            else // Cliente no encontrado, se le pregunta si desea agregarlo
            {
                var result = MessageBox.Show(
                    "Cliente no encontrado. ¿Desea ir al registro de clientes para agregarlo?",
                    "Cliente no encontrado",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question
                );
                lblDatodClienteVenta.Text = "Nombre del Cliente:"; // Restaurar texto por defecto
                if (result == DialogResult.Yes)
                {
                    tabControl1.SelectedTab = tabCliente;
                }
            }
        }

