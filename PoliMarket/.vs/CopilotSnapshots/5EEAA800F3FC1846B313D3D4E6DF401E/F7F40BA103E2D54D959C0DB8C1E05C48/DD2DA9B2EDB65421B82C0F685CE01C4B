        private void btnAgregarCarrito_Click(object sender, EventArgs e)
        {
            // Validar producto
            if (productoValidado == null)
            {
                MessageBox.Show("Debe validar un producto antes de agregarlo al carrito.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            // Obtener la cantidad desde el TextBox
            int cantidad = 0;
            int.TryParse(txtCantidadVender.Text.Trim(), out cantidad);
            // Validar cantidad mayor a 0 y menor o igual al stock
            if (cantidad <= 0)
            {
                MessageBox.Show("La cantidad debe ser mayor a 0.", "Validación", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            if (cantidad > productoValidado.Stock)
            {
                MessageBox.Show($"No hay suficiente stock disponible. Stock actual: {productoValidado.Stock}", "Stock insuficiente", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            // Formato: Nombre - Cantidad: X - Total: $Y
            double totalLinea = productoValidado.Precio * cantidad;
            string item = $"{productoValidado.Nombre} - Cantidad: {cantidad} - Total: ${totalLinea:F2}";
            listBoxCarrito.Items.Add(item);
            // Limpiar campos de producto y cantidad
            txtIDProductoVenta.Clear();
            txtCantidadVender.Clear();
            lblNombreProductoVenta.Text = "Nombre del Producto:";
            ActualizarTotalCarrito();
        }

