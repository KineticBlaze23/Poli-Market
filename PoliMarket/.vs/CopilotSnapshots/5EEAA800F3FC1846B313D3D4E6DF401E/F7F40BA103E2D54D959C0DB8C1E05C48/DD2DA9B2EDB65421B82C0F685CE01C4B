        // Mostrar el total de la compra en un label 
        private void ActualizarTotalCarrito()
        {
            double total = 0;
            foreach (var item in listBoxCarrito.Items)
            {
                // Buscar la parte que contiene "Total: $" y extraer el valor
                string itemStr = item.ToString();
                int idx = itemStr.IndexOf("Total: $");
                if (idx != -1)
                {
                    int start = idx + "Total: $".Length;
                    int end = itemStr.IndexOf(' ', start);
                    string totalStr;
                    if (end == -1)
                        totalStr = itemStr.Substring(start).Trim();
                    else
                        totalStr = itemStr.Substring(start, end - start).Trim();
                    if (double.TryParse(totalStr, out double subtotal))
                        total += subtotal;
                }
            }
            // Actualizar el label con el total de la compra
            lblTotalCarrito.Text = $"Total de la compra: ${total:F2}";
        }

        // Extrae la información de un ítem del carrito
        private bool ParseCarritoItem(string itemStr, out string nombreProducto, out int cantidad)
        {
            nombreProducto = null;
            cantidad = 0;
            int idxCantidad = itemStr.IndexOf(" - Cantidad:");
            if (idxCantidad == -1) return false;
            nombreProducto = itemStr.Substring(0, idxCantidad).Trim();
            int idxTotal = itemStr.IndexOf(" - Total:");
            if (idxTotal == -1) return false;
            string cantidadStr = itemStr.Substring(idxCantidad + " - Cantidad:".Length, idxTotal - (idxCantidad + " - Cantidad:".Length)).Trim();
            return int.TryParse(cantidadStr, out cantidad);
        }

        // Obtiene la lista de productos vendidos y el total desde el carrito
        private List<(Producto producto, int cantidad)> GetProductosVendidosDesdeCarrito(out double totalVenta)
        {
            var productosVendidos = new List<(Producto producto, int cantidad)>();
            totalVenta = 0;
            foreach (var item in listBoxCarrito.Items)
            {
                string itemStr = item.ToString();
                if (!ParseCarritoItem(itemStr, out string nombreProducto, out int cantidad)) continue;
                var producto = negocioProducto.ListarProductos().FirstOrDefault(p => p.Nombre == nombreProducto);
                if (producto != null && cantidad <= producto.Stock)
                {
                    productosVendidos.Add((producto, cantidad));
                    totalVenta += producto.Precio * cantidad;
                }
            }
            return productosVendidos;
        }

        private void btnFinalizarCompra_Click(object sender, EventArgs e)
        {
            try
            {
                if (listBoxCarrito.Items.Count == 0)
                {
                    MessageBox.Show("El carrito está vacío.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
                string cedulaCliente = txtCedulaClienteVenta.Text.Trim();
                var cliente = negocioCliente.ListarClientes().FirstOrDefault(c => c.Cedula == cedulaCliente);
                if (cliente == null)
                {
                    MessageBox.Show("Debe validar un cliente antes de finalizar la compra.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
                double totalVenta;
                var productosVendidos = GetProductosVendidosDesdeCarrito(out totalVenta);
                if (productosVendidos.Count == 0)
                {
                    MessageBox.Show("No hay productos válidos en el carrito.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
                negocioVenta.CargarVentasDesdeTxt(rutaArchivoVenta);
                int idCliente = cliente.IdCliente;
                DateTime fechaVenta = DateTime.Now;
                var ventaPrincipal = negocioVenta.RegistrarVenta(idCliente, totalVenta, fechaVenta);
                int idVenta = ventaPrincipal.IdVenta;
                using (var writer = new System.IO.StreamWriter(rutaArchivoVenta, true))
                {
                    if (new FileInfo(rutaArchivoVenta).Length == 0)
                    {
                        writer.WriteLine("IdVenta,IdCliente,IdProducto,Cantidad,PrecioUnitario,Total,Fecha");
                    }
                    foreach (var (producto, cantidad) in productosVendidos)
                    {
                        var venta = new Venta(idVenta, idCliente, producto.IdProducto, cantidad, producto.Precio, cantidad * producto.Precio, fechaVenta);
                        writer.WriteLine($"{venta.IdVenta},{venta.IdCliente},{venta.IdProducto},{venta.Cantidad},{venta.PrecioUnitario},{venta.Total},{venta.Fecha:dd/MM/yyyy HH:mm}");
                    }
                }
                foreach (var (producto, cantidad) in productosVendidos)
                {
                    producto.Stock -= cantidad;
                    negocioProducto.ActualizarProducto(producto);
                }
                GuardarProductos();
                ActualizarListaProductos();
                listBoxCarrito.Items.Clear();
                txtCedulaClienteVenta.Clear();
                lblDatodClienteVenta.Text = string.Empty;
                lblNombreProductoVenta.Text = string.Empty;
                lblTotalCarrito.Text = "Total de la compra: $0.00";
                MessageBox.Show($"Compra finalizada. Total: ${totalVenta:F2}", "Éxito", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error al finalizar la compra: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

