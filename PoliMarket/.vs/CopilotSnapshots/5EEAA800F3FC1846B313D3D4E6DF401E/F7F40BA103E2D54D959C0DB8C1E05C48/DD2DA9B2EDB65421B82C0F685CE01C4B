                if (!File.Exists(rutaArchivoVenta))
                    File.WriteAllText(rutaArchivoVenta, "IdVenta,IdCliente,IdProducto,Cantidad,PrecioUnitario,Total,Fecha\r\n");
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error creando archivos de datos: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

